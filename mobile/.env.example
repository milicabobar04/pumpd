# Kopiraj ovaj fajl u .env (ne ide u git) i upiši IP svog računara.
# IP: Windows -> ipconfig, red "IPv4 Address" pod "Wireless LAN adapter Wi-Fi".
# Telefon i računar moraju biti na istoj mreži. Android emulator može koristiti i 10.0.2.2.
# Poslije izmjene pokreni: npm start -- -c

# Mock server (npm run mock)
EXPO_PUBLIC_API_URL=http://TVOJA_IP:4010

# Pravi backend (Spring Boot)
# EXPO_PUBLIC_API_URL=http://TVOJA_IP:8080/api
