# Primjer postavki za docker-compose.yml. Kopiraj u .env (taj fajl NE ide u git) i upiši svoje
# vrijednosti. Uputstvo: docs/odbrana.md.

# Korisnik baze za aplikaciju (ne root) i njegova lozinka.
DB_USER=pumpd
DB_PASSWORD=upisi-jaku-lozinku

# Lozinka za root korisnika baze (aplikacija je ne koristi; MySQL je traži pri prvom pokretanju).
DB_ROOT_PASSWORD=upisi-drugu-jaku-lozinku

# Ključ za potpisivanje tokena (Base64, najmanje 256 bita). Napraviti sa: openssl rand -base64 32
# Razvojni ključ iz application.properties nije dozvoljen.
JWT_SECRET=

# Opciono: vremenska zona (podrazumijevano Europe/Sarajevo) i port backenda (podrazumijevano 8080).
# TZ=Europe/Sarajevo
# BACKEND_PORT=8080
